# Copy this file to .env. Never commit/share real credentials.
# Groq key used only when a verifier role or RAG answer generator is explicitly set to Groq.
GROQ_API_KEY=gsk_replace_with_your_key

# Termux SSH password used only by the dedicated OnePlus control page.
ONEPLUS_SSH_PASSWORD=replace-with-your-termux-ssh-password
